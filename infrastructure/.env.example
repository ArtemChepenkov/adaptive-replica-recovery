# Copy to infrastructure/.env. All published ports bind to localhost.
COMPOSE_PROJECT_NAME=replica-recovery
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
CRUISE_CONTROL_PORT=9090
PROMETHEUS_PORT=9091
# lab-up.sh sets dev (4 brokers) or final (6); set explicitly for direct Compose calls.
MONITORING_PROFILE=dev
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
# For a longer healthcheck wait, prefix lab-up with LAB_WAIT_TIMEOUT=600.

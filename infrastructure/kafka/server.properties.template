node.id=@BROKER_ID@
process.roles=@PROCESS_ROLES@
broker.rack=@BROKER_RACK@
controller.quorum.voters=1@broker-1:9093,2@broker-2:9093,3@broker-3:9093
controller.listener.names=CONTROLLER
listeners=@LISTENERS@
advertised.listeners=INTERNAL://broker-@BROKER_ID@:9092,EXTERNAL://localhost:@EXTERNAL_PORT@
listener.security.protocol.map=CONTROLLER:PLAINTEXT,INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
inter.broker.listener.name=INTERNAL
log.dirs=/var/lib/kafka/data
num.partitions=24
default.replication.factor=3
min.insync.replicas=2
offsets.topic.replication.factor=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2
auto.create.topics.enable=false
group.initial.rebalance.delay.ms=0
metric.reporters=com.linkedin.kafka.cruisecontrol.metricsreporter.CruiseControlMetricsReporter
cruise.control.metrics.reporter.bootstrap.servers=broker-1:9092,broker-2:9092,broker-3:9092
cruise.control.metrics.reporter.metrics.reporting.interval.ms=10000
cruise.control.metrics.topic.auto.create=true
cruise.control.metrics.topic.replication.factor=3
cruise.control.metrics.topic.num.partitions=1
cruise.control.metrics.topic.min.insync.replicas=2
